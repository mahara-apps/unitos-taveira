# =============================================================================
# Unitos — variáveis de ambiente de uma INSTALAÇÃO nova
# Copie para o gerenciador de secrets da instalação e preencha.
# NUNCA comite valores reais. Todos os valores abaixo são placeholders.
# =============================================================================

# --- Supabase (projeto exclusivo desta instalação) ---------------------------
SUPABASE_PROJECT_ID=<project-id>
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
VITE_SUPABASE_PROJECT_ID=<project-id>
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# --- Domínio público desta instalação ---------------------------------------
# Obrigatório: usado em links de aprovação, portal, e-mails e URLs de compliance.
PUBLIC_APP_URL=https://<dominio-da-instalacao>

# --- Segredos exclusivos desta instalação (gerar aleatórios) ----------------
# Cifra credenciais gravadas no banco (inclui o App Secret do modo "client").
BRAND_CREDENTIALS_SECRET=<segredo-aleatorio-unico>
# Autentica os endpoints /api/public/cron/* (header x-cron-secret).
CRON_SECRET=<segredo-aleatorio-unico>
# Assina o `state` do OAuth Meta — isola esta instalação das demais.
META_STATE_SECRET=<segredo-aleatorio-unico>

# --- Meta: App oficial Unitos (modo padrão "unitos") ------------------------
# Obrigatório apenas enquanto a instalação estiver em "Unitos — App Meta oficial".
# No modo "Cliente — App Meta próprio" estas variáveis são IGNORADAS: as
# credenciais vêm de Administração → App Meta.
META_APP_ID=<app-id-do-app-oficial>
META_APP_SECRET=<app-secret-do-app-oficial>
# Config ID de uma configuração de "Facebook Login for Business" do App oficial.
# Não existe valor universal: cada App tem o seu.
META_BUSINESS_CONFIG_ID=<config-id-do-app-oficial>

# --- Meta: por instalação ---------------------------------------------------
META_REDIRECT_URI=https://<dominio-da-instalacao>/api/public/meta/callback
META_WEBHOOK_VERIFY_TOKEN=<token-unico-da-instalacao>
# opcionais
# META_EXTRA_REDIRECT_HOSTS=preview.<dominio-da-instalacao>
# META_WEBHOOK_PEERS=https://outra-instalacao.com,https://terceira-instalacao.com

# --- E-mail transacional (opcional) -----------------------------------------
# RESEND_API_KEY=<resend-api-key>

# --- WhatsApp / Evolution API (opcional) ------------------------------------
# EVOLUTION_API_URL=https://<host-evolution>
# EVOLUTION_API_KEY=<evolution-api-key>
